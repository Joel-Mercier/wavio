+ * The ExoPlayer holds nothing in that case, so a session built on it reports a
+ * stale track and a paused state, and its play button starts the phone's own
+ * audio on top of the remote. Swapping this in as the session's player while the
+ * remote owns playback makes the notification, the lock screen and every media
+ * controller reflect what is really playing.
+ *
+ * Metadata is not carried here: [MetadataInjectingPlayer] wraps this and keeps
+ * supplying whatever the JS layer last passed to `updateLockScreenMetadata`,
+ * exactly as it does for local playback. This only owns transport state.
+ */
+@OptIn(UnstableApi::class)
+internal class RemotePlaybackPlayer(
+  private val onPlay: () -> Unit,
+  private val onPause: () -> Unit,
+  private val onSeek: (positionMs: Long) -> Unit,
+  private val onSetVolume: (volumePercent: Int) -> Unit,
+  initialVolume: Int
+) : SimpleBasePlayer(Looper.getMainLooper()) {
+
+  @Volatile private var playing: Boolean = false
+  // The remote device's volume as a percentage. Reporting it as a remote
+  // DeviceInfo is what makes the session claim the hardware volume keys: the
+  // OS then adjusts this instead of the phone's media stream, and the change
+  // goes back to JS to be sent to the device.
+  @Volatile private var volume: Int = initialVolume.coerceIn(0, 100)
+  @Volatile private var volumeBeforeMute: Int = -1
+  @Volatile private var positionMs: Long = 0L
+  @Volatile private var positionUpdatedAt: Long = System.currentTimeMillis()
+  @Volatile private var durationMs: Long = 0L
+  // Set for exactly one state update when a push moves the position by more than
+  // playback alone could explain. Media3 treats a same-item position change under
+  // its own 1s threshold as continuous progress and never republishes it, so the
+  // notification's seek bar would keep extrapolating from the value it last saw.
+  private var pendingDiscontinuityMs: Long = C.TIME_UNSET
+
+  private val mainHandler = Handler(Looper.getMainLooper())
+
+  // SimpleBasePlayer requires its application thread (main). JS calls land on
+  // the JS thread, so hop to the main looper before mutating + invalidating.
+  private fun runOnMain(block: () -> Unit) {
+    if (Looper.myLooper() == Looper.getMainLooper()) block() else mainHandler.post(block)
+  }
+
+  // Whether a push would move anything the notification or the custom layout is
+  // built from. A plain position tick would not — position travels in the
+  // session's PlaybackState — but a jump is worth the refresh.
+  fun controlsWouldChange(isPlaying: Boolean, posMs: Long, durMs: Long): Boolean =
+    playing != isPlaying || durationMs != durMs.coerceAtLeast(0L) || isJump(posMs)
+
+  private fun currentPositionMs(): Long = if (playing) {
+    positionMs + (System.currentTimeMillis() - positionUpdatedAt)
+  } else {
+    positionMs
+  }
+
+  // Matches media3's own POSITION_DISCONTINUITY_THRESHOLD_MS, so anything it
+  // would have downgraded to DISCONTINUITY_REASON_INTERNAL is raised as a seek
+  // instead, while the caller's 1s pulse stays quiet.
+  private fun isJump(posMs: Long): Boolean =
+    Math.abs(posMs.coerceAtLeast(0L) - currentPositionMs()) > POSITION_JUMP_TOLERANCE_MS
+
+  fun applyVolume(volumePercent: Int) = runOnMain {
+    val next = volumePercent.coerceIn(0, 100)
+    if (next == volume) return@runOnMain
+    volume = next
+    if (next > 0) volumeBeforeMute = -1
+    invalidateState()
+  }
+
+  fun applyState(isPlaying: Boolean, posMs: Long, durMs: Long) = runOnMain {
+    if (isJump(posMs)) pendingDiscontinuityMs = posMs.coerceAtLeast(0L)
+    playing = isPlaying
+    positionMs = posMs.coerceAtLeast(0L)
+    positionUpdatedAt = System.currentTimeMillis()
+    durationMs = durMs.coerceAtLeast(0L)
+    invalidateState()
+    // invalidateState reads the state synchronously on this thread, so clearing
+    // here rather than inside getState keeps that pure — media3 also calls it
+    // outside an update (a controller connecting, a placeholder state).
+    pendingDiscontinuityMs = C.TIME_UNSET
+  }
+
+  override fun getState(): State {
+    // A remote reports its position every second at best, so advance it off the
+    // wall clock between pushes or the notification's seek bar would step.
+    val extrapolated = currentPositionMs()
+
+    // One placeholder item, carrying only the duration. The session needs a
+    // non-empty timeline — media3 drops transport commands inside BasePlayer on
+    // an empty one — but the item itself is never shown: MetadataInjectingPlayer
+    // supplies title/artist/artwork on top of it.
+    val item = MediaItemData.Builder(REMOTE_ITEM_UID)
+      .setMediaItem(MediaItem.Builder().setMediaId(REMOTE_ITEM_UID).build())
+      .setDurationUs(if (durationMs > 0) durationMs * 1000 else C.TIME_UNSET)
+      .build()
+
+    val commands = Player.Commands.Builder()
+      .add(Player.COMMAND_PLAY_PAUSE)
+      .add(Player.COMMAND_PREPARE)
+      .add(Player.COMMAND_SEEK_IN_CURRENT_MEDIA_ITEM)
+      .add(Player.COMMAND_GET_CURRENT_MEDIA_ITEM)
+      .add(Player.COMMAND_GET_METADATA)
+      .add(Player.COMMAND_GET_DEVICE_VOLUME)
+      .add(Player.COMMAND_SET_DEVICE_VOLUME_WITH_FLAGS)
+      .add(Player.COMMAND_ADJUST_DEVICE_VOLUME_WITH_FLAGS)
+      // COMMAND_GET_TIMELINE is deliberately absent, and COMMAND_SEEK_TO_NEXT /
+      // PREVIOUS are added by the forwarding wrapper in AudioControlsService —
+      // see the notes on resolveSessionPlayer for both.
+      .build()
+
+    val state = State.Builder()
+      .setAvailableCommands(commands)
+      .setDeviceInfo(REMOTE_DEVICE)
+      .setDeviceVolume(volume)
+      .setIsDeviceMuted(volume == 0)
+      .setPlayWhenReady(playing, Player.PLAY_WHEN_READY_CHANGE_REASON_USER_REQUEST)
+      .setPlaybackState(Player.STATE_READY)
+      .setPlaylist(ImmutableList.of(item))
+      .setCurrentMediaItemIndex(0)
+      .setContentPositionMs(extrapolated.coerceAtLeast(0L))
+    // An explicit discontinuity always wins over media3's own heuristic, which
+    // would otherwise report this same-uid jump as INTERNAL — a reason the
+    // platform session does not act on. SimpleBasePlayer clears it after the
+    // update, so it applies to this state only.
+    if (pendingDiscontinuityMs != C.TIME_UNSET) {
+      state.setPositionDiscontinuity(
+        Player.DISCONTINUITY_REASON_SEEK,
+        pendingDiscontinuityMs
+      )
+    }
+    return state.build()
+  }
+
+  override fun handleSetPlayWhenReady(playWhenReady: Boolean): ListenableFuture<*> {
+    if (playWhenReady) onPlay() else onPause()
+    return Futures.immediateVoidFuture()
+  }
+
+  override fun handlePrepare(): ListenableFuture<*> = Futures.immediateVoidFuture()
+
+  override fun handleSeek(
+    mediaItemIndex: Int,
+    positionMs: Long,
+    seekCommand: Int
+  ): ListenableFuture<*> {
+    // Track skips never reach here: the forwarding wrapper intercepts
+    // seekToNext/Previous and routes them to the JS queue, so anything left is a
+    // position seek within the current track.
+    onSeek(positionMs.coerceAtLeast(0L))
+    return Futures.immediateVoidFuture()
+  }
+
+  override fun handleSetDeviceVolume(deviceVolume: Int, flags: Int): ListenableFuture<*> {
+    changeVolume(deviceVolume)
+    return Futures.immediateVoidFuture()
+  }
+
+  override fun handleIncreaseDeviceVolume(flags: Int): ListenableFuture<*> {
+    changeVolume(volume + VOLUME_STEP)
+    return Futures.immediateVoidFuture()
+  }
+
+  override fun handleDecreaseDeviceVolume(flags: Int): ListenableFuture<*> {
+    changeVolume(volume - VOLUME_STEP)
+    return Futures.immediateVoidFuture()
+  }
+
+  override fun handleSetDeviceMuted(muted: Boolean, flags: Int): ListenableFuture<*> {
+    if (muted) {
+      if (volume > 0) volumeBeforeMute = volume
+      changeVolume(0)
+    } else if (volume == 0) {
+      changeVolume(if (volumeBeforeMute > 0) volumeBeforeMute else VOLUME_STEP)
+    }
+    return Futures.immediateVoidFuture()
+  }
+
+  // The field is updated here so the very next getState() already reflects the
+  // press — the base class re-reads it once the returned future completes; the
+  // device itself is told through JS.
+  private fun changeVolume(target: Int) {
+    val next = target.coerceIn(0, 100)
+    volume = next
+    onSetVolume(next)
+  }
+
+  private companion object {
+    const val REMOTE_ITEM_UID = "expo-audio-remote-playback"
+    const val POSITION_JUMP_TOLERANCE_MS = 1000L
+    // One hardware key press. Chromecast and most renderers step in fifteenths
+    // or twentieths; this keeps a full sweep to about as many presses.
+    const val VOLUME_STEP = 5
+    val REMOTE_DEVICE: DeviceInfo = DeviceInfo.Builder(DeviceInfo.PLAYBACK_TYPE_REMOTE)
+      .setMaxVolume(100)
+      .build()
+  }
+}
+
+internal class MediaButtonSpec(
+  val icon: Int,
+  val appIcon: String,
+  val legacyIcon: Int,
+  val displayName: String,
+  val action: String
+)
+
+// A server-transcoded stream can't seek, so JS seeks it by re-requesting it from
+// an offset (Subsonic `timeOffset`). The reloaded media then starts partway into
+// the track and, served without a length, looks live to ExoPlayer, so the
+// session would publish no position at all. While JS reports such an offset,
+// present the whole track and hand seeks back to JS to reload at the new point.
+@UnstableApi
+internal class OffsetStreamPlayer(
+  player: Player,
+  private val audioPlayer: AudioPlayer
+) : ForwardingPlayer(player) {
+  private val offsetMs: Long?
+    get() = audioPlayer.streamOffsetMs
+
+  private fun trackPosition(position: Long): Long {
+    val offset = offsetMs ?: return position
+    return if (position < 0) position else position + offset
+  }
+
+  private fun trackDuration(duration: Long): Long {
+    val offset = offsetMs ?: return duration
+    audioPlayer.metadata?.durationMs?.takeIf { it > 0 }?.let { return it.toLong() }
+    return if (duration == C.TIME_UNSET) duration else duration + offset
+  }
+
+  private fun requestSeek(positionMs: Long) {
+    audioPlayer.emitRemoteSeek(positionMs.coerceAtLeast(0L))
+  }
+
+  override fun getCurrentPosition(): Long = trackPosition(super.getCurrentPosition())
+
+  override fun getContentPosition(): Long = trackPosition(super.getContentPosition())
+
+  override fun getBufferedPosition(): Long = trackPosition(super.getBufferedPosition())
+
+  override fun getContentBufferedPosition(): Long =
+    trackPosition(super.getContentBufferedPosition())
+
+  override fun getDuration(): Long = trackDuration(super.getDuration())
+
+  override fun getContentDuration(): Long = trackDuration(super.getContentDuration())
+
+  override fun isCurrentMediaItemLive(): Boolean =
+    offsetMs == null && super.isCurrentMediaItemLive()
+
+  override fun isCurrentMediaItemDynamic(): Boolean =
+    offsetMs == null && super.isCurrentMediaItemDynamic()
+
+  override fun isCurrentMediaItemSeekable(): Boolean =
+    offsetMs != null || super.isCurrentMediaItemSeekable()
+
+  override fun getCurrentLiveOffset(): Long =
+    if (offsetMs != null) C.TIME_UNSET else super.getCurrentLiveOffset()
+
+  override fun getAvailableCommands(): Player.Commands {
+    val commands = super.getAvailableCommands()
+    if (offsetMs == null) return commands
+    return commands.buildUpon()
+      .addAll(
+        Player.COMMAND_SEEK_IN_CURRENT_MEDIA_ITEM,
+        Player.COMMAND_SEEK_BACK,
+        Player.COMMAND_SEEK_FORWARD
+      )
+      .build()
+  }
+
+  override fun isCommandAvailable(command: Int): Boolean =
+    if (offsetMs == null) super.isCommandAvailable(command) else availableCommands.contains(command)
+
+  override fun seekTo(positionMs: Long) {
+    if (offsetMs == null) super.seekTo(positionMs) else requestSeek(positionMs)
+  }
+
+  override fun seekTo(mediaItemIndex: Int, positionMs: Long) {
+    if (offsetMs == null) super.seekTo(mediaItemIndex, positionMs) else requestSeek(positionMs)
+  }
+
+  override fun seekBack() {
+    if (offsetMs == null) super.seekBack() else requestSeek(currentPosition - seekBackIncrement)
+  }
+
+  override fun seekForward() {
+    if (offsetMs == null) super.seekForward() else requestSeek(currentPosition + seekForwardIncrement)
+  }
+}
