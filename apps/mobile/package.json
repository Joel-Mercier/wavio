{
  "name": "wavio",
  "main": "index.js",
  "version": "1.4.0",
  "license": "MIT",
  "scripts": {
    "start": "eas env:exec --non-interactive development \"APP_VARIANT=development expo start\"",
    "prebuild": "bunx expo prebuild",
    "doctor": "bunx expo-doctor",
    "analyze:export": "EXPO_ATLAS=1 bunx expo export --platform android",
    "analyze": "bunx expo-atlas .expo/atlas.jsonl",
    "reset-project": "bun ./scripts/reset-project.js",
    "android": "eas env:exec --non-interactive development \"APP_VARIANT=development DARK_MODE=media expo run:android\"",
    "ios": "eas env:exec --non-interactive development \"APP_VARIANT=development DARK_MODE=media expo run:ios\"",
    "web": "eas env:exec --non-interactive development \"APP_VARIANT=development DARK_MODE=media expo start --web\"",
    "test": "bunx jest",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "typecheck": "bunx tsc --noEmit",
    "prebuild:github": "EXPO_PUBLIC_DISTRIBUTION=github bunx expo prebuild -p android",
    "prebuild:store": "EXPO_PUBLIC_DISTRIBUTION=store bunx expo prebuild -p android",
    "prebuild:development": "APP_VARIANT=development bun run prebuild:github",
    "prebuild:preview": "APP_VARIANT=preview bun run prebuild:github",
    "build:android:development": "bun run prebuild:development && eas build -p android --profile development --local",
    "build:android:preview": "bun run prebuild:preview && eas build -p android --profile preview --local --output $PWD/../../tmp/wavio-preview-$npm_package_version.apk",
    "build:android:production": "bun run prebuild:store && eas build -p android --profile production --local --output $PWD/../../tmp/wavio-$npm_package_version.aab",
    "build:android:production-apk": "bun run prebuild:github && eas build -p android --profile production-apk --local --output $PWD/../../tmp/wavio-$npm_package_version-arm64-v8a.apk",
    "build:android:production-apk-armv7": "bun run prebuild:github && eas build -p android --profile production-apk-armv7 --local --output $PWD/../../tmp/wavio-$npm_package_version-armeabi-v7a.apk",
    "submit:android:closed": "eas submit -p android --profile closed",
    "submit:android:production": "eas submit -p android --profile production"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry|native-base|standard-navigation))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/html-elements": "^58.0.3",
    "@expo/metro-runtime": "~58.0.14",
    "@gluestack-ui/core": "^5.0.15",
    "@gluestack-ui/utils": "^5.0.6",
    "@gorhom/bottom-sheet": "^5.2.13",
    "@legendapp/list": "^3.6.0",
    "@legendapp/motion": "^2.5.3",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@sentry/react-native": "~8.28.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.4",
    "axios": "^1.20.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "expo": "~58.0.14",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.16",
    "expo-audio": "58.0.9",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "58.0.9",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-in-app-updates": "^0.12.0",
    "expo-intent-launcher": "~58.0.3",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-media-library": "~58.0.10",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.23",
    "expo-screen-orientation": "~58.0.3",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-store-review": "~58.0.2",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "fast-xml-parser": "^5.11.2",
    "fuse.js": "^7.5.0",
    "html-entities": "^2.6.0",
    "i18next": "^26.5.2",
    "ignore": "^7.0.12",
    "intl-pluralrules": "^2.0.1",
    "lucide-react-native": "^1.59.0",
    "pinyin-pro": "^3.29.5",
    "react": "19.3.0",
    "react-aria": "^3.53.1",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.0",
    "react-native": "0.88.0",
    "react-native-carplay": "^2.4.1-beta.0",
    "react-native-drawer-layout": "^4.2.10",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-cast": "^4.9.1",
    "react-native-image-colors": "^2.6.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-pager-view": "9.0.7",
    "react-native-react-query-devtools": "^1.5.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-share": "^12.3.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "uniwind": "1.12.2",
    "wanakana": "^5.3.1",
    "zod": "4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@react-native/jest-preset": "0.88.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "expo-atlas": "^0.4.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "jscodeshift": "^17.4.0",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-audio",
          "expo-file-system"
        ]
      }
    }
  }
}
