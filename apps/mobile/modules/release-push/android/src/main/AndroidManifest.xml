<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <!-- No FCM token exists until the user's setting subscribes to the topic,
         and turning the setting off deletes it again. -->
    <meta-data
      android:name="firebase_messaging_auto_init_enabled"
      android:value="false" />

    <service
      android:name="expo.modules.releasepush.ReleasePushService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
