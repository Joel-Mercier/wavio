<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!--
      Two filters, not one: the Data Layer matches MESSAGE_RECEIVED on a path
      prefix but matches CAPABILITY_CHANGED on an exact path equal to the
      capability name, so they cannot share a <data> element.
    -->
    <service
      android:name="expo.modules.wearbridge.WavioWearListenerService"
      android:exported="true">
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
        <data android:scheme="wear" android:host="*" android:pathPrefix="/wavio/" />
      </intent-filter>
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
        <data android:scheme="wear" android:host="*" android:path="/wavio_watch" />
      </intent-filter>
    </service>
  </application>
</manifest>
