{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "extends": "//",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/android",
      "!!**/ios",
      "!**/*.svg",
      "!**/i18n/*.json",
      "!**/global.css",
      "!**/uniwind-types.d.ts"
    ]
  },
  "linter": {
    "rules": {
      "correctness": {
        "noReactNativeRawText": {
          "level": "error",
          "options": {
            "skip": [
              "AccordionContentText",
              "AccordionTitleText",
              "ActionsheetItemText",
              "ActionsheetSectionHeaderText",
              "AlertText",
              "AvatarFallbackText",
              "BadgeText",
              "ButtonText",
              "FormControlErrorText",
              "FormControlHelperText",
              "FormControlLabelText",
              "Heading",
              "LinkText",
              "SelectInputText",
              "SelectSectionHeaderText"
            ]
          }
        }
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "lucide-react-native": "Import icons from \"lucide-react-native/icons/<kebab-name>\" instead. Metro can't tree-shake the barrel, so a single root import pulls all ~1750 icons (~3MB) into the bundle.",
              "lucide-react-native/icons": "Import icons from \"lucide-react-native/icons/<kebab-name>\" instead. This is the icons barrel: Metro can't tree-shake it, so it pulls all ~1750 icons (~3MB) into the bundle."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["__tests__/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    }
  ]
}
