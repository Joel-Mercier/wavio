{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "extends": "//",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/android",
      "!!**/ios",
      "!**/*.svg",
      "!**/i18n/*.json",
      "!**/global.css",
      "!**/uniwind-types.d.ts"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "lucide-react-native": "Import icons from \"lucide-react-native/dist/esm/icons/<kebab-name>.mjs\" instead. Metro can't tree-shake the barrel, so a single root import pulls all ~1750 icons (~3MB) into the bundle."
            }
          }
        }
      }
    }
  }
}
