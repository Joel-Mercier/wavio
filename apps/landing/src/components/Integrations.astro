---
import Audiobookshelf from "../assets/audiobookshelf.svg";
import AudioMuseAi from "../assets/audiomuse-ai.webp";
import LastFm from "../assets/lastfm.svg";
import Lidarr from "../assets/lidarr.svg";
import ListenBrainz from "../assets/listenbrainz.svg";
import MusicBrainz from "../assets/musicbrainz.svg";
import SoulSync from "../assets/soulsync.webp";
import Tidarr from "../assets/tidarr.svg";
import { type Lang, useTranslations } from "../i18n/utils";
import IntegrationLogo from "./IntegrationLogo.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const ti = t.integrations;
const copy = ti.items as Record<string, { role: string; desc: string }>;

/**
 * Adding a service: append an entry here and add its `role` / `desc` to the
 * `integrations.items` block in `i18n/en.json` under the same id. `tint` is the
 * service's brand color and drives the panel glow; services with no logo fall
 * back to `initials`.
 */
const integrations = [
	{
		id: "musicbrainz",
		name: "MusicBrainz",
		url: "https://musicbrainz.org/",
		host: "musicbrainz.org",
		tint: "#ba478f",
		Svg: MusicBrainz,
	},
	{
		id: "listenbrainz",
		name: "ListenBrainz",
		url: "https://listenbrainz.org/",
		host: "listenbrainz.org",
		tint: "#eb743b",
		Svg: ListenBrainz,
	},
	{
		id: "lastfm",
		name: "Last.fm",
		url: "https://www.last.fm/",
		host: "last.fm",
		tint: "#d51007",
		Svg: LastFm,
	},
	{
		id: "lidarr",
		name: "Lidarr",
		url: "https://lidarr.audio/",
		host: "lidarr.audio",
		tint: "#009252",
		Svg: Lidarr,
	},
	{
		id: "soulsync",
		name: "SoulSync",
		url: "https://ssync.net/",
		host: "ssync.net",
		tint: "#8b5cf6",
		image: SoulSync,
	},
	{
		id: "tidarr",
		name: "Tidarr",
		url: "https://github.com/cstaelen/tidarr",
		host: "github.com/cstaelen",
		tint: "#22d3ee",
		Svg: Tidarr,
	},
	{
		id: "audiomuse-ai",
		name: "AudioMuse-AI",
		url: "https://github.com/NeptuneHub/AudioMuse-AI",
		host: "github.com/NeptuneHub",
		tint: "#f4728e",
		image: AudioMuseAi,
	},
	{
		id: "octo-fiesta",
		name: "Octo-Fiesta",
		url: "https://github.com/V1ck3s/octo-fiesta",
		host: "github.com/V1ck3s",
		tint: "#10b981",
		initials: "OF",
	},
	{
		id: "audiobookshelf",
		name: "Audiobookshelf",
		url: "https://www.audiobookshelf.org/",
		host: "audiobookshelf.org",
		tint: "#cd9d49",
		Svg: Audiobookshelf,
	},
];
---

<section id="integrations" class="relative pb-25 pt-20">
	<div class="mx-auto max-w-[1280px] px-8">
		<div class="mb-14 grid grid-cols-1 items-end gap-x-15 gap-y-6 lg:grid-cols-2">
			<div>
				<div class="mb-7 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.14em] text-accent">
					<span class="h-px w-8 bg-accent"></span> {ti.tag}
				</div>
				<h2 class="text-[clamp(40px,5.5vw,76px)] font-extrabold leading-[1.02] tracking-[-0.04em] text-balance">
					{ti.headingPre} <em class="font-extrabold italic text-accent pr-[0.12em]">{ti.headingEm}</em>
				</h2>
			</div>
			<p class="self-end text-lg text-text-2 text-pretty">{ti.sub}</p>
		</div>

		<div class="grid grid-cols-1 gap-3.5 lg:grid-cols-[minmax(0,360px)_1fr]">
			<div class="relative min-w-0 overflow-hidden rounded-[20px] border border-border bg-bg-2">
			<div
				role="tablist"
				aria-label={ti.tag}
				aria-orientation="horizontal"
				class="int-rail flex overflow-x-auto overscroll-x-contain lg:absolute lg:inset-0 lg:block lg:overflow-x-hidden lg:overflow-y-auto lg:overscroll-y-contain"
			>
				{
					integrations.map((item, i) => (
						<button
							type="button"
							role="tab"
							id={`int-tab-${item.id}`}
							aria-controls={`int-panel-${item.id}`}
							aria-selected={i === 0 ? "true" : "false"}
							tabindex={i === 0 ? 0 : -1}
							data-int-tab={item.id}
							class:list={[
								"int-row relative flex shrink-0 items-center gap-2.5 px-3.5 py-3 text-left transition-colors duration-200 lg:w-full lg:shrink lg:gap-4 lg:px-5 lg:py-4",
								i > 0 && "border-l border-border lg:border-l-0 lg:border-t",
							]}
						>
							<span class="int-marker absolute inset-x-0 bottom-0 h-[3px] bg-accent transition-opacity duration-200 lg:inset-x-auto lg:inset-y-0 lg:left-0 lg:h-auto lg:w-[3px]" />
							<span class="int-logo flex size-7 shrink-0 items-center justify-center transition duration-300 lg:size-9">
								<IntegrationLogo Svg={item.Svg} image={item.image} initials={item.initials} tint={item.tint} loading="lazy" />
							</span>
							<span class="min-w-0">
								<span class="int-name block truncate whitespace-nowrap text-sm font-bold tracking-[-0.01em] transition-colors duration-200 lg:text-base">
									{item.name}
								</span>
								<span class="int-role hidden text-[10px] font-bold uppercase tracking-[0.16em] transition-colors duration-200 lg:block">
									{copy[item.id].role}
								</span>
							</span>
						</button>
					))
				}
			</div>
			<button
				type="button"
				tabindex="-1"
				aria-hidden="true"
				data-int-more
				class="int-more absolute right-2 top-1/2 flex size-8 -translate-y-1/2 items-center justify-center rounded-full border border-border-strong bg-surface text-text-2 shadow-[0_6px_20px_rgba(0,0,0,0.55)] hover:border-accent hover:text-text lg:right-3 lg:top-auto lg:bottom-3 lg:translate-y-0"
			>
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lg:rotate-90">
					<path d="m9 6 6 6-6 6" />
				</svg>
			</button>
			</div>

			<div class="flex flex-col gap-3.5">
				{
					integrations.map((item) => (
						<div
							id={`int-panel-${item.id}`}
							role="tabpanel"
							aria-labelledby={`int-tab-${item.id}`}
							tabindex="0"
							data-int-panel={item.id}
							class="int-panel relative isolate flex items-center overflow-hidden rounded-[20px] border border-border bg-bg-2 p-8 sm:p-10 lg:min-h-[434px]"
						>
							<span
								class="pointer-events-none absolute inset-0 -z-10"
								style={`background: radial-gradient(ellipse 58% 72% at 82% 45%, ${item.tint}33, transparent 68%)`}
							/>
							<span
								class="pointer-events-none absolute inset-x-0 top-0 h-px"
								style={`background: linear-gradient(270deg, ${item.tint}, transparent 62%)`}
							/>

							<div class="flex w-full flex-col-reverse items-start gap-9 lg:flex-row lg:items-center lg:gap-12">
								<div class="min-w-0 flex-1">
									<div class="mb-3 text-[11px] font-bold uppercase tracking-[0.14em] text-accent">
										{copy[item.id].role}
									</div>
									<h3 class="mb-3.5 text-[clamp(26px,3vw,34px)] font-bold leading-[1.1] tracking-[-0.02em]">
										{item.name}
									</h3>
									<p class="mb-9 max-w-[46ch] text-[15px] text-text-2 text-pretty">{copy[item.id].desc}</p>
									<a
										href={item.url}
										target="_blank"
										rel="noopener"
										class="inline-flex w-fit items-center gap-2.5 rounded-[14px] border border-border-strong px-5 py-3 text-sm font-medium text-text-2 transition-colors duration-200 hover:border-accent hover:bg-accent-soft hover:text-text"
									>
										{item.host}
										<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<path d="M7 17 17 7M9 7h8v8" />
										</svg>
									</a>
								</div>
								<span class="flex size-20 shrink-0 items-center justify-center sm:size-24 lg:size-44">
									<IntegrationLogo
										Svg={item.Svg}
										image={item.image}
										initials={item.initials}
										tint={item.tint}
										loading="eager"
										initialsClass="text-[26px] lg:rounded-[18px] lg:text-[52px]"
									/>
								</span>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<script>
	const root = document.getElementById('integrations');
	const tabs = root ? [...root.querySelectorAll<HTMLButtonElement>('[data-int-tab]')] : [];
	const panels = root ? [...root.querySelectorAll<HTMLElement>('[data-int-panel]')] : [];

	if (tabs.length) {
		const rail = root!.querySelector<HTMLElement>('[role="tablist"]')!;
		const more = root!.querySelector<HTMLButtonElement>('[data-int-more]')!;
		const wide = window.matchMedia('(min-width: 1024px)');
		// Matches the fade length in the styles, so a revealed tab clears the faded edge.
		const EDGE = 56;

		const syncEdges = () => {
			const vertical = wide.matches;
			const offset = vertical ? rail.scrollTop : rail.scrollLeft;
			const max = vertical ? rail.scrollHeight - rail.clientHeight : rail.scrollWidth - rail.clientWidth;
			rail.toggleAttribute('data-fade-start', offset > 1);
			rail.toggleAttribute('data-fade-end', offset < max - 1);
		};
		const syncOrientation = () => {
			rail.setAttribute('aria-orientation', wide.matches ? 'vertical' : 'horizontal');
			syncEdges();
		};
		syncOrientation();
		wide.addEventListener('change', syncOrientation);
		rail.addEventListener('scroll', syncEdges, { passive: true });
		const resize = new ResizeObserver(syncEdges);
		for (const el of [rail, ...tabs]) resize.observe(el);

		more.addEventListener('click', () => {
			const page = (wide.matches ? rail.clientHeight : rail.clientWidth) * 0.75;
			rail.scrollBy(wide.matches ? { top: page, behavior: 'smooth' } : { left: page, behavior: 'smooth' });
		});

		// Nudges the rail's own scroll only, so this can never move the page. Scrolls
		// instantly on purpose: `behavior: 'smooth'` is dropped outright in throttled
		// rendering contexts, which would leave the chosen chip off-screen.
		const revealInRail = (tab: HTMLElement) => {
			const railBox = rail.getBoundingClientRect();
			const tabBox = tab.getBoundingClientRect();
			if (tabBox.left < railBox.left + EDGE) rail.scrollBy({ left: tabBox.left - railBox.left - EDGE });
			else if (tabBox.right > railBox.right - EDGE) rail.scrollBy({ left: tabBox.right - railBox.right + EDGE });
			if (tabBox.top < railBox.top + EDGE) rail.scrollBy({ top: tabBox.top - railBox.top - EDGE });
			else if (tabBox.bottom > railBox.bottom - EDGE) rail.scrollBy({ top: tabBox.bottom - railBox.bottom + EDGE });
		};

		const select = (id: string, moveFocus = false) => {
			for (const tab of tabs) {
				const active = tab.dataset.intTab === id;
				tab.setAttribute('aria-selected', String(active));
				tab.tabIndex = active ? 0 : -1;
				if (active && moveFocus) tab.focus();
				if (active) revealInRail(tab);
			}
			for (const panel of panels) panel.hidden = panel.dataset.intPanel !== id;
		};

		// Panels ship visible so the section still reads without JS; collapse to one here.
		select(tabs[0].dataset.intTab!);

		tabs.forEach((tab, i) => {
			tab.addEventListener('click', () => select(tab.dataset.intTab!));
			tab.addEventListener('keydown', (e) => {
				let next = i;
				if (e.key === 'ArrowDown' || e.key === 'ArrowRight') next = (i + 1) % tabs.length;
				else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
				else if (e.key === 'Home') next = 0;
				else if (e.key === 'End') next = tabs.length - 1;
				else return;
				e.preventDefault();
				select(tabs[next].dataset.intTab!, true);
			});
		});
	}
</script>

<style>
	@property --int-fade-start { syntax: '<length>'; inherits: false; initial-value: 0px; }
	@property --int-fade-end { syntax: '<length>'; inherits: false; initial-value: 0px; }

	.int-rail {
		--int-fade-dir: to right;
		scrollbar-width: none;
		mask-image: linear-gradient(
			var(--int-fade-dir),
			transparent,
			#000 var(--int-fade-start),
			#000 calc(100% - var(--int-fade-end)),
			transparent
		);
		transition: --int-fade-start 0.25s, --int-fade-end 0.25s;
	}
	.int-rail::-webkit-scrollbar { display: none; }
	.int-rail[data-fade-start] { --int-fade-start: 56px; }
	.int-rail[data-fade-end] { --int-fade-end: 56px; }
	@media (min-width: 1024px) {
		.int-rail { --int-fade-dir: to bottom; }
	}

	/* Only shown while there is more of the list past the end edge. */
	.int-more {
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s, color 0.2s, border-color 0.2s;
	}
	.int-rail[data-fade-end] ~ .int-more { opacity: 1; pointer-events: auto; }
	.int-row { background: transparent; }
	.int-name { color: var(--color-text-2); }
	.int-role { color: var(--color-text-3); }
	.int-marker { opacity: 0; }

	/* Each service keeps its own color, but only once it's the one on screen. */
	.int-logo { filter: grayscale(0.72) brightness(1.15); opacity: 0.6; }
	.int-row:hover .int-logo { filter: grayscale(0.3); opacity: 0.95; }
	.int-row:hover .int-name { color: var(--color-text); }

	.int-row[aria-selected='true'] { background: var(--color-surface); }
	.int-row[aria-selected='true'] .int-logo { filter: none; opacity: 1; }
	.int-row[aria-selected='true'] .int-name { color: var(--color-text); }
	.int-row[aria-selected='true'] .int-role { color: var(--color-accent); }
	.int-row[aria-selected='true'] .int-marker { opacity: 1; }

	.int-row:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -2px; }
	.int-panel:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

	/* Tailwind's `.flex` would otherwise win over the `[hidden]` attribute. */
	.int-panel[hidden] { display: none; }

	@media (prefers-reduced-motion: reduce) {
		.int-row, .int-row *, .int-rail, .int-more { transition-duration: 0.01ms !important; }
	}
</style>
